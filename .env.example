NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<from supabase start output or dashboard>
SUPABASE_SERVICE_ROLE_KEY=<from supabase start output or dashboard>

# MCP server (optional)
NIMA_USER_ID=<your auth.users UUID>

# App Store Connect release automation (keep real values in an ignored .env file)
APP_STORE_CONNECT_KEY_ID=<team key ID>
APP_STORE_CONNECT_ISSUER_ID=<issuer UUID>
APP_STORE_CONNECT_PRIVATE_KEY_PATH=<absolute path to AuthKey_KEYID.p8>
